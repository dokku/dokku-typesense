#!/usr/bin/env python3
"""Deletes every collection in the service, with what was made alongside them.

Aliases point at collections and go first. Synonym sets, curation sets,
presets, stopwords and analytics rules are kept apart from the collections they
apply to from typesense 30 on, so they are deleted too where the server has
them; an older one answers 404 for the list, and has none to delete. The api
keys an app authenticates with are kept, since only what was made through the
api is deleted rather than the data directory they live in beside it.
"""
import json
import os
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

HOST = os.environ.get("TYPESENSE_HOST", "127.0.0.1")
PORT = os.environ.get("TYPESENSE_PORT", "8108")
API_KEY = os.environ["TYPESENSE_API_KEY"]
TIMEOUT_SECONDS = int(os.environ.get("TYPESENSE_HEALTH_TIMEOUT_SECONDS", "60"))

# the list each kind of object is read from, the key the list is under when it
# is not the whole response, and the field that names one
OPTIONAL = [
    ("synonym_sets", "synonym_sets", "name"),
    ("curation_sets", "curation_sets", "name"),
    ("presets", "presets", "name"),
    ("stopwords", "stopwords", "id"),
    ("analytics/rules", "rules", "name"),
]


def request(path, method="GET"):
    url = "http://{}:{}/{}".format(HOST, PORT, path)
    headers = {"X-TYPESENSE-API-KEY": API_KEY}
    message = urllib.request.Request(url, headers=headers, method=method)

    with urllib.request.urlopen(message) as response:
        return json.load(response)


def healthy():
    # the port answers before the server is ready, and a request made then is
    # refused
    deadline = time.monotonic() + TIMEOUT_SECONDS
    while time.monotonic() < deadline:
        try:
            if request("health").get("ok"):
                return True
        except (urllib.error.URLError, ValueError):
            pass
        time.sleep(1)

    sys.stderr.write("typesense did not become healthy within {}s\n".format(TIMEOUT_SECONDS))
    return False


def names(response, key, field):
    items = response.get(key, []) if isinstance(response, dict) else response
    return [item[field] for item in items if field in item]


def delete(path, items):
    for name in items:
        try:
            request("{}/{}".format(path, urllib.parse.quote(name, safe="")), method="DELETE")
        except urllib.error.HTTPError as error:
            # one deleted along with something deleted before it is already gone
            if error.code == 404:
                continue
            sys.stderr.write("unable to remove {} {}: {}\n".format(path, name, error.read().decode()))
            return False

    return True


def main():
    if not healthy():
        return 1

    if not delete("aliases", names(request("aliases"), "aliases", "name")):
        return 1

    if not delete("collections", names(request("collections"), "collections", "name")):
        return 1

    for path, key, field in OPTIONAL:
        try:
            response = request(path)
        except urllib.error.HTTPError as error:
            if error.code == 404:
                continue
            raise

        if not delete(path, names(response, key, field)):
            return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
